 {
  "id": "wger:1314",
  "source_id": 1314,
  "name": "Jumping jack HD",
  "name_en": "Jumping Jack HD",
  "aliases": [
   "Jumping Jack HD",
   "Jumping jack HD"
  ],
  "category": "Cardio",
