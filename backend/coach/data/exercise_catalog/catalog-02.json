  "id": "wger:206",
  "source_id": 206,
  "name": "Fentes marchées avec haltères",
  "name_en": "Dumbbell Lunges Walking",
  "aliases": [
   "Dumbbell Lunges Walking",
   "Fentes marchées avec haltères",
   "Walking Lunges"
  ],
  "category": "Legs",
