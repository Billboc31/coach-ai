 {
  "id": "wger:1734",
  "source_id": 1734,
  "name": "Fente sur une jambe avec kettlebell",
  "name_en": "Single-Leg Lunge with Kettlebell:",
  "aliases": [
   "Fente sur une jambe avec kettlebell",
   "Single-Leg Lunge with Kettlebell:"
  ],
  "category": "Legs",
  "equipment": [
