  "source_id": 57,
  "name": "Marche de l'ours 2",
  "name_en": "Bear Walk 2",
  "aliases": [
   "Bear Walk 2",
   "Marche de l'ours 2"
  ],
  "category": "Chest",
  "equipment": [
